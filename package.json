{
  "name": "hiramekun-sites",
  "version": "0.1.0",
  "private": true,
  "description": "hiramekun.dev (プロフィール) と blog.hiramekun.dev (ブログ) のモノレポ",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hiramekun/blog",
    "dev:blog": "npm run dev -w @hiramekun/blog",
    "dev:profile": "npm run dev -w @hiramekun/profile",
    "build": "npm run build --workspaces --if-present",
    "build:blog": "npm run build -w @hiramekun/blog",
    "build:profile": "npm run build -w @hiramekun/profile",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p functions/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
